    { "pattern": "REIGN_ROADMAP.md", "reason": "Roadmap-only changes require no compilation." },
    { "pattern": "**/docs/**", "reason": "Agent and subsystem documentation is non-code." },
    { "pattern": "**/README.md", "reason": "Documentation-only change." },
    { "pattern": "**/THIRD_PARTY_NOTICES.md", "reason": "Third-party notice text is non-code." }
