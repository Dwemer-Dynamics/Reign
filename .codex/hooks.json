{
  "description": "Enforces the canonical Reign MCP build and validation path.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"D:\\Projects\\Reign\\.codex\\hooks\\enforce-reign-validation.ps1\"",
            "timeout": 10,
            "statusMessage": "Enforcing Reign MCP validation"
          }
        ]
      }
    ]
  }
}
