                            <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="228" SuggestedHeight="24" MarginLeft="31" MarginTop="503" Brush="Info.Text" Brush.Font="ReignSerifDynamic" Brush.FontSize="11" Brush.TextHorizontalAlignment="Center" Brush.TextVerticalAlignment="Center" Brush.FontColor="#C5BDAFFF" Text="@StatusText" />
