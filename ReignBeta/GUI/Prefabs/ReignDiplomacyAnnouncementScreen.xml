                    <ReignPortraitWidget Id="ActorAIPortrait" Type="ReignBeta.UI.Widgets.ReignPortraitWidget" DoNotAcceptEvents="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="244" SuggestedHeight="244" HorizontalAlignment="Center" VerticalAlignment="Center" PortraitCacheKey="@ActorPortraitCacheKey" />
