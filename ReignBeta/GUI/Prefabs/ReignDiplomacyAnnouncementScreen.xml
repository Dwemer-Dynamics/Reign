                <TextWidget Id="DiplomacyDate" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="22" MarginTop="42" Brush="DefaultText" Brush.Font="ReignSerifDynamic" Brush.FontSize="13" Brush.TextHorizontalAlignment="Center" Brush.FontColor="#7E6A4DFF" Text="@DateText" />
