              <Children>
                <Widget Id="DiplomacyAcknowledgeArt" DoNotAcceptEvents="true" IsVisible="false" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" />
                <TextWidget Id="DiplomacyAcknowledgeLabel" DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="DefaultText" Brush.Font="ReignSerifDynamic" Brush.FontSize="22" Brush.TextHorizontalAlignment="Center" Brush.FontColor="#C5AC83FF" Text="A C K N O W L E D G E" />
