              <Children>
                <ImageIdentifierWidget Id="ActorBanner" DoNotAcceptEvents="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="72" SuggestedHeight="78" MarginLeft="7" MarginTop="7" ImageId="@ActorBannerId" AdditionalArgs="@ActorBannerArgs" TextureProviderName="@ActorBannerProvider" />
                <Widget Id="ActorBannerFrame" DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="reign_modern_banner_shield_overlay" />
              </Children>
            </Widget>
            <TextWidget Id="ActorReason" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="218" SuggestedHeight="78" MarginLeft="150" MarginTop="701" Brush="DefaultText" Brush.Font="ReignSerifDynamic" Brush.FontSize="16" Brush.TextHorizontalAlignment="Center" Brush.FontColor="#C5BDAFFF" Text="@ActorReason" />

            <Widget Id="TargetGroup" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" IsVisible="@ShowTarget">
