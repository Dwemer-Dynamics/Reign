            <ImageWidget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="reign_court_modern_shell" />

            <!-- Runtime title and ruler identity occupy the generated empty plaque. -->
