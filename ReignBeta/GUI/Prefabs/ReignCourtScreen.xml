            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="350" SuggestedHeight="682" MarginLeft="41" MarginTop="114">
              <Children>
                <ScrollablePanel WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="322" SuggestedHeight="638" MarginLeft="12" MarginTop="18" ClipRect="CompactCourtRowsClip" InnerPanel="CompactCourtRowsClip\CompactCourtRowsList" VerticalScrollbar="..\CompactCourtRowsScrollbar" AutoHideScrollBars="false" MouseScrollAxis="Vertical">
