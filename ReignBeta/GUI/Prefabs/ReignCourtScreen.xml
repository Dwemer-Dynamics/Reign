                                <ImageWidget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="reign_court_petition_attendee_card_modern" />
                                <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="190" SuggestedHeight="25" MarginLeft="105" MarginTop="12" Brush="DefaultText" Brush.Font="ReignSerifDynamic" Brush.FontSize="13" Brush.FontColor="#C5AC83FF" Brush.TextHorizontalAlignment="Left" Text="@Title" />
                                <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="190" SuggestedHeight="38" MarginLeft="105" MarginTop="39" Brush="DefaultText" Brush.Font="ReignSerifDynamic" Brush.FontSize="9" Brush.FontColor="#8A8883FF" Brush.TextHorizontalAlignment="Left" Text="@Subtitle" />
