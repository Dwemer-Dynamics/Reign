                        <ListPanel Id="CompactCourtRowsList" DataSource="{TabRows}" WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren" SuggestedWidth="322" StackLayout.LayoutMethod="VerticalTopToBottom">
