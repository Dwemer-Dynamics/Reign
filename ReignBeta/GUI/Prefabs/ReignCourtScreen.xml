            <ButtonWidget IsVisible="@RoyalCommandsVisible" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="290" SuggestedHeight="88" MarginLeft="1168" MarginTop="628" Brush="ConversationItem.SoundBrush" Command.Click="ExecuteOpenRoyalCouncil">
