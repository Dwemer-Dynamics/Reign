                            <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="208" SuggestedHeight="56" MarginLeft="57" MarginTop="54" Brush="DefaultText" Brush.Font="ReignSerifDynamic" Brush.FontSize="9" Brush.FontColor="#C5BDAFFF" Brush.TextHorizontalAlignment="Left" Text="@Subtitle" />
