                <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="176" SuggestedHeight="21" MarginLeft="101" MarginTop="39" Brush="DefaultText" Brush.Font="ReignSerifDynamic" Brush.FontSize="12" Brush.FontColor="#C5BDAFFF" Brush.TextHorizontalAlignment="Left" Text="@ChancellorName" />
                <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="176" SuggestedHeight="18" MarginLeft="101" MarginTop="62" Brush="DefaultText" Brush.Font="ReignSerifDynamic" Brush.FontSize="8" Brush.FontColor="#A88A54FF" Brush.TextHorizontalAlignment="Left" Text="@ChancellorStateText" />
                <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="176" SuggestedHeight="22" MarginLeft="101" MarginTop="82" Brush="DefaultText" Brush.Font="ReignSerifDynamic" Brush.FontSize="8" Brush.FontColor="#8A8883FF" Brush.TextHorizontalAlignment="Left" Text="@ChancellorSalaryText" />
                <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="80" SuggestedHeight="20" MarginLeft="11" MarginTop="117" Command.Click="ExecuteOpenCourtHistory">
                  <Children>
                    <ImageWidget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="reign_court_navigation_button_modern" />
                    <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="DefaultText" Brush.Font="ReignSerifDynamic" Brush.FontSize="8" Brush.FontColor="#C5AC83FF" Brush.TextHorizontalAlignment="Center" Brush.TextVerticalAlignment="Center" Text="HISTORY" />
