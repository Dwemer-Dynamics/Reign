            </ButtonWidget>

            <!-- Three interface entrances sit at the foot of the throne artwork. -->
            <ButtonWidget IsVisible="@RoyalCommandsVisible" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="245" SuggestedHeight="55" MarginLeft="630" MarginTop="642" Command.Click="ExecuteRoyalProclamation">
