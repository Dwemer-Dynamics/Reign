            <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="286" SuggestedHeight="24" MarginLeft="60" MarginTop="254" Brush="DefaultText" Brush.Font="ReignSerifDynamic" Brush.FontSize="13" Brush.FontColor="#A88A54FF" Brush.TextHorizontalAlignment="Center" Text="PETITIONS" />
