            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="1056" SuggestedHeight="682" MarginLeft="418" MarginTop="114">
              <Children>
                <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="44" MarginLeft="36" MarginRight="36" MarginTop="30" Brush="DefaultText" Brush.Font="ReignSerifDynamic" Brush.FontSize="26" Brush.FontColor="#A88A54FF" Brush.TextHorizontalAlignment="Center" Text="@DetailTitle" />
