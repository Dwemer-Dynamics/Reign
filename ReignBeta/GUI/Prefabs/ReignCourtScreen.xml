<Prefab>
  <Window>
    <!-- The outer canvas deliberately rejects events. Only the centered Court
         workspace and its controls participate in hit testing, leaving the
         native campaign HUD and exposed map interactive. -->
    <Widget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent">
      <Children>
        <!-- 1518x854 is the measured 16:9 workspace inside a 1920x1080 logical
             canvas. MarginTop 150 reserves the native top HUD; the remaining
             76 pixels reserve the native date and time-control bar. -->
