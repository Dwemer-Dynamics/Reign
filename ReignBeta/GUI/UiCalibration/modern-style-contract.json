    "fullBody": "rectangle",
    "memoryScene": "memory",
    "castleOccupancySlot": "circle",
    "emptyCastleOccupancySlot": "circle-with-muted-grey-silhouette",
    "standaloneIndividualChatHeader": "vertical-oval",
    "standaloneIndividualChatFullBodyZoom": "rectangle",
    "nativeConversationAdditionalPortrait": "rectangle",
    "sourceImageRule": "Portrait source files remain byte-for-byte untouched rectangular imagery. They are centered and slightly oversized beneath the approved plate; they must never be rewritten, pre-masked, alpha-cut, tinted, padded, bordered, or baked with framing.",
    "frameOverlayRule": "Every registered circle, oval, or portrait rectangle is an opaque black-marble aperture plate above the portrait. Its exterior and corners conceal the source rectangle; only the exact declared aperture is transparent. Approved antique-gold linework remains topmost, while opaque inner backing disks and pale neutral or white seams are forbidden.",
    "completePortraitCardRule": "Every portrait-bearing card is one complete moving raster asset whose opaque plate, border, portrait frame, and true-alpha aperture are physically integrated. The unchanged portrait source is a sibling beneath that card. A generic rectangle combined with a separate ring, mask, or frame is forbidden, and a fixed shell must not retain a superseded portrait hole behind the card roster.",
    "layerOrder": [
      "dynamic-portrait-source-unchanged",
      "centered-cover-portrait-source",
      "opaque-black-marble-aperture-plate-with-gold-frame"
    ]
  },
  "compositionOrder": [
    "bounded-content-viewport",
    "untouched-dynamic-texture",
    "opaque-aperture-plate",
    "topmost-gold-frame-and-ornament"
  ],
  "typography": {
    "conversationActions": {
      "approvedDate": "2026-09-05",
      "widgets": "RichTextWidget in individual, party, castle, social-event and tavern-house chat transcripts",
      "brushes": [
        "Reign.Chat.ActionText.15",
        "Reign.Chat.ActionText.16",
        "Reign.Chat.ActionText.17"
      ],
      "defaultFont": "ReignSerifDynamic",
      "actionFont": "ReignSerifActionItalic",
      "rule": "User-approved action-only Cormorant Garamond Medium Italic variant, same size and primary body color as adjacent upright speech. No fixed-shell or geometry changes. Only generated span style=Action markup is permitted."
    },
    "status": "baked-fixed-live-dynamic",
    "rule": "Fixed titles, section labels, and ornament-integrated captions are baked into the approved shell artwork. Only genuinely dynamic or state-dependent content remains live, and its typography must match the latest approved reference as closely as the Bannerlord/Gauntlet renderer permits.",
    "canonicalBrush": {
      "default": "DefaultText",
      "allowedNativeSerifBrushes": [
        "DefaultText",
        "Info.Text"
      ],
      "explicitFontAttribute": "Brush.Font",
      "requiredExplicitFontFace": "ReignSerifDynamic",
      "selectionRule": "Use DefaultText or Info.Text for the approved role behavior, but explicitly declare Brush.Font=ReignSerifDynamic on every remaining live TextWidget and EditableTextWidget. The alias is a module-local Cormorant Garamond Medium SDF font. Fixed shell lettering must not also exist as hidden or transparent runtime text."
    },
    "fontPolicy": {
      "familyAndFace": "Fixed shell lettering uses the exact approved raster pixels. Every genuinely dynamic or state-dependent live text widget explicitly declares Brush.Font=ReignSerifDynamic; DefaultText or Info.Text without that declaration is not sufficient and must fail acceptance.",
      "weight": "Match the approved regular or emphasized weight without synthetic bold, glow, outline, or shadow unless that treatment is visibly present in the approved reference.",
      "capitalizationAndTracking": "Preserve the approved capitalization, small-cap treatment, and deliberate letter spacing. Literal spaced capitals are permitted where Gauntlet exposes no tracking control.",
      "sizeAndHierarchy": "Match each approved title, section heading, body, secondary, muted, button, caption, and numeric tier at the closest supported native font size.",
      "alignmentAndWrapping": "Match approved horizontal and vertical alignment, baseline, line spacing, wrapping width, and truncation behavior."
    },
    "textEffects": {
      "policy": "No standalone approved reference uses synthetic outline, glow, blur, or shadow text effects. These attributes must be absent or numerically inactive.",
      "forbiddenNonzeroAttributes": [
        "Brush.TextOutlineAmount",
        "Brush.TextGlowRadius",
        "Brush.TextBlur",
        "Brush.TextShadowAmount",
        "Brush.TextShadowOffset",
        "Brush.TextShadowColor"
      ]
    },
    "colorRoles": {
      "secondaryGoldAndMetadata": "#7E6A4DFF",
      "titleAndSectionHeading": "#A88A54FF",
      "focalControlAndSmallHighlight": "#C5AC83FF",
      "primaryBody": "#C5BDAFFF",
      "secondaryBody": "#8A8883FF",
      "mutedBody": "#706F6AFF",
      "negativeState": "#C35B32FF",
      "disabled": "#4A4945FF"
    },
    "acceptance": {
      "fontFamilyAndFaceMustMatch": true,
      "fontBrushMustBeExplicit": true,
      "fontFaceMustBeExplicit": true,
      "requiredFontFace": "ReignSerifDynamic",
      "syntheticTextEffectsMustBeInactive": true,
      "textColorMustUseExactFrozenToken": true,
      "closestSupportedSizeRequired": true,
      "maximumFontSizeDifferencePixels": 1,
      "maximumBaselineDifferencePixels": 1,
      "maximumTrackingDifferencePixels": 1,
      "dynamicWordingDoesNotExemptTypography": true,
      "failurePolicy": "An unexplained font, size hierarchy, alignment, tracking, weight, or text-color mismatch fails acceptance even when the text content itself is allowed to vary."
    }
  },
  "protectedContent": {
    "warCouncilMap": {
      "interfaceId": "war-council",
      "rule": "preserve-source-bytes-and-intended-old-scroll-color-exactly",
      "allowedChanges": [
        "rectangular clipping to the approved viewport",
        "transparent frame overlay composited above the map",
        "runtime red-blue channel-order normalization required to counter Bannerlord's texture-upload interpretation; this is a decode correction, not an art edit"
      ],
      "forbiddenChanges": [
        "tint",
        "desaturation",
        "grayscale conversion",
        "brightness or contrast adjustment",
        "darkening",
        "marble reduction",
        "color grading",
        "baked frame treatment"
      ],
      "acceptanceEvidence": "protected source and tile SHA-256 values remain unchanged; native old-scroll samples match the intended warm channel order after the isolated runtime decode correction"
    }
  },
