      {
        "id": "native-initial-screen",
        "label": "Main Menu Logo",
        "target": "InitialScreen",
        "basePrefab": "Native/GUI/Prefabs/InitialScreen.xml",
        "sources": [
          "src/Modules/UI/UI/ReignMainMenuLogoPrefabPatches.cs"
        ]
      },
      {
