  "nativeCalibration": {
    "targetCount": 22,
    "uniqueRuntimeMovieCount": 21,
    "previewerSupportMovie": "ReignUiCalibrationOverlay",
    "providerFreeFixtureTargets": [
      "correspondence",
      "individual-chat",
      "party-chat",
      "tavern-house",
      "social-event",
      "wilderness-event",
      "diplomacy-announcement",
      "notable-generation",
      "memories-book"
    ],
    "contract": "Every runtime movie owned by the Reign client has a cataloged prefab and ui-open target. Dialogue, correspondence, social-event, diplomacy, notable-generation, Court Petition, and Memories Book calibration fixtures are temporary, provider-free, and may not write conversation, letter, event, petition, relationship, reputation, pressure, memory-image, or campaign-action state."
  },
