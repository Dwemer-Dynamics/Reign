  "nativeCalibration": {
    "targetCount": 26,
    "uniqueRuntimeMovieCount": 25,
    "previewerSupportMovie": "ReignUiCalibrationOverlay",
    "providerFreeFixtureTargets": [
      "party-banter",
      "action-builder",
      "correspondence",
      "individual-chat",
      "party-chat",
      "tavern-house",
      "social-event",
      "wilderness-event",
      "diplomacy-announcement",
      "notable-generation",
      "memories-book",
      "portrait-refresh"
    ],
    "contract": "Every runtime movie owned by the Reign client has a cataloged prefab and ui-open target. Dialogue, correspondence, social-event, diplomacy, notable-generation, Court Petition, and Memories Book calibration fixtures are temporary, provider-free, and may not write conversation, letter, event, petition, relationship, reputation, pressure, memory-image, or campaign-action state."
  },
  "nativeAugmentations": {
    "targetCount": 7,
    "patchApplicationCount": 9,
    "contract": "Every PrefabExtension application in ReignBeta client source is cataloged by native target and authoritative installed base-prefab path. These are Reign additions to native Bannerlord interfaces rather than standalone Reign movies; their source attributes, XPath targets, patch classes, and inserted XML remain source-discovered and are audited separately from the 18 standalone prefab files.",
