    <ReignTestingSource Include="$(MSBuildThisFileDirectory)..\src\Modules\WorldSimulation\Arrests\ReignArrestTestHost.cs" />
    <ReignTestingSource Include="$(MSBuildThisFileDirectory)..\src\Modules\WorldSimulation\Campaign\ReignActionGauntlet.cs" />
