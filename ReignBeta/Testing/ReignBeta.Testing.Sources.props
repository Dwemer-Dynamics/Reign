<Project>
  <!-- Single list of the in-game test harness sources compiled into the optional
       ReignBeta.Testing.dll. ReignBeta.Testing.csproj compiles them; ReignBeta.csproj removes them
       from its own compilation and builds the testing project after itself. The files stay in
       their owning module folders, so module ownership in reign.modules.json is unchanged.
       Product code reaches these types only through ReignBeta.Runtime.ReignTestHarness.
       Types that are save-registered, used as saved fields, or called by product code stay in
       ReignBeta. -->
  <ItemGroup>
    <ReignTestingSource Include="$(MSBuildThisFileDirectory)..\src\Modules\Characters\Campaign\ReignEncounteredResidentNativeTestHost.cs" />
    <ReignTestingSource Include="$(MSBuildThisFileDirectory)..\src\Modules\Characters\Campaign\ReignNpcLivesAnnouncementFixture.cs" />
    <ReignTestingSource Include="$(MSBuildThisFileDirectory)..\src\Modules\Characters\Campaign\ReignNpcLivesComposerFixture.cs" />
