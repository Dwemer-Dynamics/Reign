    <ReignTestingSource Include="$(MSBuildThisFileDirectory)..\src\Modules\Dialogue\Campaign\ReignLiveInteractionConversationClockHost.cs" />
    <ReignTestingSource Include="$(MSBuildThisFileDirectory)..\src\Modules\Dialogue\Campaign\ReignLiveInteractionCorrespondenceHost.cs" />
    <ReignTestingSource Include="$(MSBuildThisFileDirectory)..\src\Modules\Diplomacy\ClanAccords\ReignClanAccordNativeTests.cs" />
    <ReignTestingSource Include="$(MSBuildThisFileDirectory)..\src\Modules\Government\Testing\ReignGovernmentCertificationTests.cs" />
