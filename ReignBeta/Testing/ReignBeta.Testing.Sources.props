    <ReignTestingSource Include="$(MSBuildThisFileDirectory)..\src\Modules\Government\Testing\ReignGovernmentHearingNativeTests.cs" />
    <ReignTestingSource Include="$(MSBuildThisFileDirectory)..\src\Modules\Government\Testing\ReignGovernmentInGameTests.cs" />
    <ReignTestingSource Include="$(MSBuildThisFileDirectory)..\src\Modules\Government\Testing\ReignGovernmentPlayerFlowTests.cs" />
    <ReignTestingSource Include="$(MSBuildThisFileDirectory)..\src\Modules\Government\Testing\ReignGovernmentPrivateConversationTests.cs" />
    <ReignTestingSource Include="$(MSBuildThisFileDirectory)..\src\Modules\Government\Testing\ReignLiveInteractionGovernmentHost.cs" />
    <ReignTestingSource Include="$(MSBuildThisFileDirectory)..\src\Modules\KingdomEvents\Campaign\ReignKingdomEventInGameTests.cs" />
    <ReignTestingSource Include="$(MSBuildThisFileDirectory)..\src\Modules\KingdomEvents\Campaign\ReignLiveInteractionKingdomEventHost.cs" />
