<Project Sdk="Microsoft.NET.Sdk">
  <!-- Optional in-game test harness: live interaction host, action gauntlet, fixtures, in-game
       tests and test server clients (see ReignBeta.Testing.Sources.props). ReignBeta.csproj builds
       this project after itself into the same output folder, passing ReignClientOutputPath, so
       ReignBeta.Testing.dll lands next to ReignBeta.dll. SubModule loads it when present and installs
       its IReignTestHarness; the module works without it.
       ReignBeta.dll is referenced as a built file, never as a ProjectReference, which would form a
       cycle. A standalone build of this project (no ReignClientOutputPath) first builds ReignBeta into
       its own output folder with ReignSkipTestingAssembly=true, then compiles against that. -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>ReignBeta.Testing</AssemblyName>
    <RootNamespace>ReignBeta</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\..\..\.version_number.txt').Trim())</Version>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
    <LangVersion>latest</LangVersion>
    <OutputPath>..\bin\Win64_Shipping_Client\</OutputPath>
    <BannerlordPath Condition="'$(BannerlordPath)' == ''">$(REIGN_BANNERLORD_PATH)</BannerlordPath>
    <BannerlordWorkshopPath Condition="'$(BannerlordWorkshopPath)' == ''">$(BannerlordPath)\..\..\workshop\content\261550</BannerlordWorkshopPath>
    <ReignServerRoot Condition="'$(ReignServerRoot)' == ''">$(MSBuildProjectDirectory)\..\..\..\ReignServer</ReignServerRoot>
    <ReignTestingStandalone Condition="'$(ReignClientOutputPath)' == ''">true</ReignTestingStandalone>
    <ReignClientOutputPath Condition="'$(ReignClientOutputPath)' == ''">$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(OutputPath)'))</ReignClientOutputPath>
    <ReignClientOutputPath>$([MSBuild]::EnsureTrailingSlash('$(ReignClientOutputPath)'))</ReignClientOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(ExcludeCourt)' == 'true'">
    <DefineConstants>$(DefineConstants);REIGN_EXCLUDE_COURT</DefineConstants>
  </PropertyGroup>

  <Import Project="ReignBeta.Testing.Sources.props" />
  <ItemGroup>
    <Compile Include="@(ReignTestingSource)" />
  </ItemGroup>
  <ItemGroup Condition="'$(ExcludeCourt)' != 'true'">
    <Compile Include="@(ReignTestingCourtSource)" />
  </ItemGroup>

  <Target Name="RequireBannerlordReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(BannerlordPath)\bin\Win64_Shipping_Client\TaleWorlds.CampaignSystem.dll')"
           Text="Set REIGN_BANNERLORD_PATH (or BannerlordPath) to your licensed Bannerlord v1.5.7 installation before validating the client." />
  </Target>

  <!-- Standalone build: compile ReignBeta (without rebuilding this project) into the same folder. -->
  <Target Name="ReignBuildClientForStandaloneTesting"
          BeforeTargets="ResolveAssemblyReferences"
          Condition="'$(ReignTestingStandalone)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <MSBuild Projects="$(MSBuildProjectDirectory)\..\ReignBeta.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);OutputPath=$(ReignClientOutputPath);ReignSkipTestingAssembly=true;ReignSkipNativePortraitGenerator=true;BannerlordPath=$(BannerlordPath);BannerlordWorkshopPath=$(BannerlordWorkshopPath);ReignServerRoot=$(ReignServerRoot);ExcludeCourt=$(ExcludeCourt)"
             BuildInParallel="false" />
  </Target>

  <ItemGroup>
    <!-- The client assemblies this harness extends, taken from the client output folder.
         ReignBeta and ReignBeta.Core grant this assembly InternalsVisibleTo. -->
    <Reference Include="ReignBeta">
      <HintPath>$(ReignClientOutputPath)ReignBeta.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ReignBeta.Core">
      <HintPath>$(ReignClientOutputPath)ReignBeta.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Reign.Core.Contracts">
      <HintPath>$(ReignClientOutputPath)Reign.Core.Contracts.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ArenaOverhaul.1.4.6">
      <HintPath>$(ReignClientOutputPath)ArenaOverhaul.1.4.6.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Numerics" Aliases="FrameworkNumerics" />
    <Reference Include="System.Numerics.Vectors" Aliases="global,NumericsVectors">
      <HintPath>$(BannerlordPath)\bin\Win64_Shipping_Client\System.Numerics.Vectors.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.CampaignSystem">
      <HintPath>$(BannerlordPath)\bin\Win64_Shipping_Client\TaleWorlds.CampaignSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.Core">
      <HintPath>$(BannerlordPath)\bin\Win64_Shipping_Client\TaleWorlds.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.Core.ViewModelCollection">
      <HintPath>$(BannerlordPath)\bin\Win64_Shipping_Client\TaleWorlds.Core.ViewModelCollection.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.CampaignSystem.ViewModelCollection">
      <HintPath>$(BannerlordPath)\bin\Win64_Shipping_Client\TaleWorlds.CampaignSystem.ViewModelCollection.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.Engine">
      <HintPath>$(BannerlordPath)\bin\Win64_Shipping_Client\TaleWorlds.Engine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.Engine.GauntletUI">
